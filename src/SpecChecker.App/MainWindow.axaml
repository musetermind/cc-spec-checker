<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SpecChecker.App.MainWindow"
        Width="880" Height="840"
        WindowStartupLocation="CenterScreen"
        Background="Black" Foreground="#00FF00" FontFamily="Consolas">
  <!-- The window title AND the header title are set in code from
       Branding.cs, so there is one branding source of truth. -->
  <!-- Button colours live in code (MainWindow.ApplyTheme), not in XAML
       styles, so the Dark / Light / System theme toggle (0.15) can swap
       every button's palette at runtime. XAML only holds the dark
       starting values; ApplyTheme overrides them before the window shows. -->

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- Header -->
    <Border x:Name="HeaderBorder" Grid.Row="0" Background="#0A0F0A" Padding="16,10" BorderBrush="#1E521E" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock x:Name="HeaderTitle" Text="" FontSize="22" FontWeight="Bold" Foreground="#00FF00"/>
          <!-- Shop credit (Sithu, 0.14) — replaces the old tagline.
               The shop name is a button to the CC Facebook page (0.15). -->
          <StackPanel Spacing="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="CreditPrefix" Text="Presented to you by " FontSize="11" Opacity="0.7" Foreground="#00FF00"/>
              <Button x:Name="FacebookButton" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="OnFacebook" VerticalAlignment="Center">
                <TextBlock x:Name="FacebookButtonText" Text="" FontSize="11" Opacity="0.7" TextDecorations="Underline"/>
              </Button>
              <!-- Plain-text shop name, shown instead of the button when
                   the brand has no Facebook page linked. -->
              <TextBlock x:Name="ShopNameText" Text="" FontSize="11" Opacity="0.7" Foreground="#00FF00" VerticalAlignment="Center" IsVisible="False"/>
              <TextBlock x:Name="CreditSuffix" Text="" FontSize="11" Opacity="0.7" Foreground="#00FF00"/>
            </StackPanel>
            <TextBlock x:Name="CreditContact" Text="" FontSize="11" Opacity="0.7" Foreground="#00FF00"/>
          </StackPanel>
          <!-- Theme toggle (Sithu, 0.15): one button, cycles Dark -> Light -> System. -->
          <Button x:Name="ThemeButton" Content="Theme: Dark" Click="OnThemeClick"
                  HorizontalAlignment="Left" Margin="0,6,0,0" Cursor="Hand"/>
        </StackPanel>
        <!-- Refresh / Copy / Save snapshot sit here next to the admin
             button (2.1, top-right). Only the Windows tools stay in the
             strip below. The admin button hides when already elevated,
             so it does not belong in a fixed grid. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Button x:Name="RefreshButton" Click="OnRefresh"/>
          <Button x:Name="CopyButton" Click="OnCopy"/>
          <Button x:Name="SaveSnapshotButton" Click="OnSaveSnapshot"/>
          <Button x:Name="AdminButton" Click="OnRestartAsAdmin"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Quick-launch tool strip (Sithu, 0.15): two rows of six Windows
         tools. Refresh / Copy / Save snapshot moved to the header in
         2.1. Built in code (BuildToolStrip) so the buttons follow the
         active theme. -->
    <Border x:Name="ToolStripBorder" Grid.Row="1" Background="#0A0F0A" Padding="16,8" BorderBrush="#1E521E" BorderThickness="0,0,0,1">
      <ContentControl x:Name="ToolStripArea"/>
    </Border>

    <!-- Content area: the dashboard cards — each one carries all its
         info, so a glance is enough (Sithu, 0.13). No detail sections. -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="ContentArea" Margin="16"/>
    </ScrollViewer>

    <!-- Status bar -->
    <Border x:Name="StatusBorder" Grid.Row="3" Background="#0A0F0A" Padding="12,6" BorderBrush="#1E521E" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Ready." Foreground="#00FF00" VerticalAlignment="Center"/>
        <TextBlock x:Name="ReadOnlyNote" Text="Read-only — this tool changes nothing on the machine." DockPanel.Dock="Right"
                   Foreground="#00FF00" Opacity="0.5" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Branded-build credit: a small centred line at the very bottom.
         Empty for the CC build — hidden in code. -->
    <TextBlock x:Name="CreditLine" Grid.Row="4" Text="" FontSize="10" Opacity="0.6"
               Foreground="#00FF00" HorizontalAlignment="Center" Margin="0,4,0,6"/>
  </Grid>
</Window>
