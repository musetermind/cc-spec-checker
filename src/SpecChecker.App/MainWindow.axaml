<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SpecChecker.App.MainWindow"
        Title="CC Spec Checker v1.0.0 — Computer Corner"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="Black" Foreground="#00FF00" FontFamily="Consolas">
  <!-- Styles live in Window.Styles in Avalonia (not Window.Resources,
       which is for resource dictionaries). -->
  <Window.Styles>
    <!-- Header action buttons -->
    <Style Selector="Button.header">
      <Setter Property="Background" Value="#0D1F0D"/>
      <Setter Property="Foreground" Value="#00FF00"/>
      <Setter Property="BorderBrush" Value="#1E521E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.header:pointerover">
      <Setter Property="Background" Value="#1A3A1A"/>
      <Setter Property="BorderBrush" Value="#2E7D2E"/>
    </Style>
    <!-- Left-nav items -->
    <Style Selector="ListBoxItem.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#00FF00"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem.nav:pointerover">
      <Setter Property="Background" Value="#0D1F0D"/>
    </Style>
    <Style Selector="ListBoxItem.nav:selected">
      <Setter Property="Background" Value="#1A3A1A"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="#0A0F0A" Padding="16,10" BorderBrush="#1E521E" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="CC SPEC CHECKER" FontSize="22" FontWeight="Bold" Foreground="#00FF00"/>
          <TextBlock Text="Computer Corner — correct VRAM, real temperatures, honest numbers" FontSize="11" Opacity="0.7" Foreground="#00FF00"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Button Classes="header" Content="Refresh" Click="OnRefresh"/>
          <Button Classes="header" Content="Copy" Click="OnCopy"/>
          <Button Classes="header" Content="Save snapshot" Click="OnSaveSnapshot"/>
          <Button x:Name="AdminButton" Classes="header" Content="Restart as administrator" Click="OnRestartAsAdmin"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="230,*">
      <!-- Left nav -->
      <Border Grid.Column="0" Background="#050705" BorderBrush="#1E521E" BorderThickness="0,0,1,0">
        <ListBox x:Name="CategoryList" SelectionChanged="OnCategoryChanged"
                 Background="Transparent" BorderThickness="0">
          <ListBoxItem Classes="nav" Content="Summary" IsSelected="True"/>
          <ListBoxItem Classes="nav" Content="Operating System"/>
          <ListBoxItem Classes="nav" Content="CPU"/>
          <ListBoxItem Classes="nav" Content="RAM"/>
          <ListBoxItem Classes="nav" Content="Motherboard"/>
          <ListBoxItem Classes="nav" Content="Graphics"/>
          <ListBoxItem Classes="nav" Content="Storage"/>
          <ListBoxItem Classes="nav" Content="Drive Health"/>
        </ListBox>
      </Border>

      <!-- Content area: the dashboard and detail panels are built in code
           from the structured SpecModel (MainWindow.axaml.cs). -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ContentControl x:Name="ContentArea" Margin="16"/>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="#0A0F0A" Padding="12,6" BorderBrush="#1E521E" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Ready." Foreground="#00FF00" VerticalAlignment="Center"/>
        <TextBlock Text="Read-only — this tool changes nothing on the machine." DockPanel.Dock="Right"
                   Foreground="#00FF00" Opacity="0.5" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
