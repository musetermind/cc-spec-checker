<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SpecChecker.App</RootNamespace>
    <AssemblyName>CCSpecChecker</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Assembly/file version. Keep in step with AppInfo.Version (it
         cannot read that const); bump both on every release. -->
    <Version>2.3.0</Version>
    <!-- Runs UNELEVATED by default (no ApplicationManifest): WMI + DXGI +
         NVAPI all work unelevated. Only SMART and the opt-in PawnIO install
         need elevation, and those go through a helper/relaunch. -->
    <!-- v1: standalone single exe. Native libs (Skia etc.) extract on first run -->
    <!-- The app icon (Sithu, 2.0): the CPU-on-motherboard icon. The .ico
         is the exe icon (Explorer + taskbar); the .png is embedded as a
         resource for the window's title-bar icon. Both are copies of the
         files in the repo root — if the icon is ever redrawn, update the
         root files and re-copy them here. -->
    <ApplicationIcon>CCSpecChecker.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="CCSpecChecker-icon.png" />
    <!-- The bundled PawnIO 2.2.0 setup (official, signed, unmodified —
         see third-party/pawnio). Embedded so the single exe stays
         portable; extracted to %TEMP% only when the user agrees to
         install, and deleted right after. -->
    <EmbeddedResource Include="..\..\third-party\pawnio\PawnIO_setup.exe" LogicalName="PawnIO_setup.exe" />
    <PackageReference Include="Avalonia" Version="11.2.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.4" />
    <ProjectReference Include="..\SpecChecker.Core\SpecChecker.Core.csproj" />
  </ItemGroup>
</Project>
