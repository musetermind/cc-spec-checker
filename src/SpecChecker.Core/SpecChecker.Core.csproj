<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SpecChecker.Core</RootNamespace>
    <AssemblyName>SpecChecker.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Assembly/file version. Keep in step with AppInfo.Version in the
         App project; bump both on every release. -->
    <Version>1.9.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- LHM 0.9.6 requires System.Management >= 10.0.2 (its net8.0 target).
         The Toolkit used 8.0.0, but the sensor engine pins the newer one. -->
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Sensor engine (temps): pinned stable 0.9.6. MPL-2.0. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
